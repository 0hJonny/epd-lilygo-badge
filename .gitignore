# ============================================================
# Build output
# ============================================================
build/
*.bin
*.elf
*.map
*.hex

# ============================================================
# Project configuration
#
# sdkconfig is generated by the build system and contains local
# state (serial port, toolchain paths). The settings that actually
# matter for this project live in sdkconfig.defaults, which IS
# tracked - see the negation below.
#
# After pulling changes, delete sdkconfig and rebuild so the new
# defaults take effect: the build system never overwrites values
# that are already present in sdkconfig.
# ============================================================
sdkconfig
sdkconfig.old
!sdkconfig.defaults

# ============================================================
# Component manager
#
# managed_components/ is downloaded from idf_component.yml.
# dependencies.lock pins exact versions - tracking it makes
# builds reproducible, but it churns on every dependency update.
# Ignored here; remove this line if you prefer pinned builds.
# ============================================================
managed_components/
dependencies.lock

# ============================================================
# Editors and IDEs
# ============================================================
.vscode/
.idea/
cmake-build-*/
*.swp
*.swo
*~

# ============================================================
# OS noise
# ============================================================
.DS_Store
Thumbs.db
desktop.ini

# ============================================================
# Misc
# ============================================================
*.log
*.bak
__pycache__/
*.pyc
fonts/glyphs_merged.txt


